generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String             @id @default(cuid())
  email          String             @unique
  name           String
  password       String
  role           String             @default("student")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  usedInvite           InviteToken?        @relation("UsedInvite")
  moduleProgress       ModuleProgress[]
  lessonProgress       LessonProgress[]
  courseAccess         UserCourseAccess[]
  passwordResetTokens  PasswordResetToken[]
  quizAttempts         QuizAttempt[]
  certificates         Certificate[]
  productAccess        ProductAccess[]
}

model Course {
  id          String             @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  isPublished Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  invites     InviteToken[]
  modules     Module[]
  userAccess  UserCourseAccess[]
  bonuses     CourseBonus[]
}

model CourseBonus {
  id           String   @id @default(cuid())
  courseId     String
  title        String
  fileName     String   // ASCII filename on disk under course-bonuses/
  downloadName String   // original filename used for download
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Module {
  id          String           @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int
  isPublished Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lessons     Lesson[]
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    ModuleProgress[]
  certificates Certificate[]
}

model Lesson {
  id        String           @id @default(cuid())
  moduleId  String
  title     String
  videoUrl  String?
  order     Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  LessonProgress[]
  quiz      Quiz?
}

model Quiz {
  id        String         @id @default(cuid())
  lessonId  String         @unique
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions    QuizQuestion[]
  attempts     QuizAttempt[]
}

model QuizQuestion {
  id           String @id @default(cuid())
  quizId       String
  text         String
  options      Json
  correctIndex Int
  order        Int
  quiz         Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model UserCourseAccess {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  moduleLimit Int?     // null = full course; N = only first N modules (by order)
  grantedAt   DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model ModuleProgress {
  id          String   @id @default(cuid())
  userId      String
  moduleId    String
  completedAt DateTime @default(now())
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model InviteToken {
  id          String    @id @default(cuid())
  token       String    @unique @default(cuid())
  type        String    @default("course") // 'course' | 'book' | 'book_modules'
  courseId    String?
  moduleLimit Int?      // for 'book_modules': how many modules to unlock
  usedById    String?   @unique
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  usedBy      User?     @relation("UsedInvite", fields: [usedById], references: [id])
}

model Book {
  id          String        @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  pdfUrl      String?       // served via gated /api/book/pdf
  bonusPdfUrl String?       // printable bonus checklist, served via gated /api/book/checklist
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  chapters    BookChapter[]
}

model BookChapter {
  id        String   @id @default(cuid())
  bookId    String
  title     String
  audioUrl  String?  // Bunny embed/stream URL
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model ProductAccess {
  id        String   @id @default(cuid())
  userId    String
  product   String   // 'book' | 'ai'
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, product])
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  moduleId String
  issuedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module   Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  answers     Json     // int[] — избраните индекси
  score       Int
  total       Int
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
